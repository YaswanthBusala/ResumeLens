# Generated by GitHub Copilot - Nov-18-2026
# ResumeLens container for Render (or any Docker host).
# Base: Microsoft's Playwright image = Ubuntu 24.04 + Python + Chromium with all system libraries,
# so PDF export works without Edge. The tag must match the playwright version in requirements.txt.
FROM mcr.microsoft.com/playwright/python:v1.65.2-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    RESUMELENS_PUBLIC=1 \
    PORT=10000

# Metric-compatible replacements for the Windows fonts the templates use
# (Calibri->Carlito, Cambria->Caladea, Times/Arial->Liberation) + Noto for Hindi, Arabic and Chinese.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      fonts-crosextra-carlito fonts-crosextra-caladea fonts-liberation fonts-dejavu-core \
      fonts-noto-core fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/* \
 && fc-cache -f

WORKDIR /app
COPY requirements.txt .
RUN python3 -m pip install -r requirements.txt

COPY app ./app

# Run as the image's unprivileged user (never root in production).
RUN chown -R pwuser:pwuser /app
USER pwuser

EXPOSE 10000
# Render injects $PORT; bind on all interfaces inside the container.
CMD ["sh", "-c", "exec python3 -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --timeout-keep-alive 30"]
